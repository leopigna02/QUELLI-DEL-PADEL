rules_version = '2';

// Regole dell'archivio di "Quelli del padel".
// Tutti leggono; si scrivono solo dati nella forma che l'app usa.
// Non c'è un vero accesso con password: chi ha il link può segnare risultati e voti.
service cloud.firestore {
  match /databases/{database}/documents {

    // Nome del campionato, giocatori, regole del punteggio
    match /league/main {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'players', 'rules'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 32
        && request.resource.data.players is map
        && request.resource.data.players.keys().hasOnly(['p0', 'p1', 'p2', 'p3', 'p4', 'p5'])
        && request.resource.data.rules is map;
    }

    // Risultati: il nome del documento sono le quattro cifre della partita
    match /results/{id} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if id.matches('^[0-5]{4}$')
        && request.resource.data.keys().hasOnly(['a', 'b', 'at'])
        && request.resource.data.a is number && request.resource.data.a >= 0 && request.resource.data.a <= 99
        && request.resource.data.b is number && request.resource.data.b >= 0 && request.resource.data.b <= 99;
    }

    // Voti MVP: partita-chi vota, con il giocatore votato
    match /votes/{id} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if id.matches('^[0-5]{4}-[0-5]$')
        && request.resource.data.keys().hasOnly(['p', 'at'])
        && request.resource.data.p is number && request.resource.data.p >= 0 && request.resource.data.p <= 5;
    }

    // Date delle giornate
    match /dates/{id} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if id.matches('^g[0-9]{1,2}$')
        && request.resource.data.keys().hasOnly(['d'])
        && request.resource.data.d is string
        && request.resource.data.d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Bonus e malus
    match /extras/{id} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if id.matches('^[A-Za-z0-9_-]{1,40}$')
        && request.resource.data.keys().hasOnly(['p', 'pts', 'note', 'at'])
        && request.resource.data.p is number && request.resource.data.pts is number
        && request.resource.data.note is string && request.resource.data.note.size() <= 40;
    }

    // Schede dei giocatori con l'avatar
    match /profiles/{id} {
      allow read: if true;
      allow create, update: if id.matches('^p[0-5]$')
        && request.resource.data.keys().hasOnly(['profile', 'avatar', 'at'])
        && request.resource.data.profile is map
        && request.resource.data.avatar is string && request.resource.data.avatar.size() < 140000;
    }
  }
}
